{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "server",
    "src/game/constants.ts",
    "src/game/geometry.ts",
    "src/game/movement.ts",
    "src/game/simulation.ts",
    "src/game/state.ts",
    "src/game/territory.ts",
    "src/game/types.ts",
    "src/game/world.ts",
    "src/game/worldEvents.ts",
    "src/network/protocol.ts"
  ]
}
